# Files the Vercel CLI must never upload with a deployment. The CLI does not
# honor .gitignore here: before this file existed it uploaded the local `.env`
# (Production secrets) as part of the deployment source. Production and
# Preview read every value from Vercel Environment Variables instead.
.env
.env.*
!.env.example
# Any other env-style file, at any depth -- e.g. a `vercel env pull foo.env`
# that lands in the repo by mistake (pv-pull.env once did, briefly).
**/*.env
**/*.env.*
**/.env
**/.env.*
!.env.example

# Local Claude Code settings -- not part of the app.
.claude
