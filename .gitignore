# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI embedding model files (Phase 7-B): fetched at build/dev time by
# scripts/downloadModel.mjs from Hugging Face Hub (pinned revision, SHA256
# verified) -- never committed. The ONNX file alone is ~107MB, over
# GitHub's 100MB per-file push limit. See docs/AI_MATCHING_ARCHITECTURE.md.
/models
