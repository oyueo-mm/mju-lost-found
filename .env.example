# Local development: use the Preview project or a local disposable database.
# Put values in .env.development.local; do not put Production secrets in .env.
# Production operations: .env.operations-production is never auto-loaded by Next.
# Use npm run operations:production with an explicit approval reference.
DATABASE_URL=
DIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WITHDRAWN_IDENTITY_SECRET=
CRON_SECRET=
