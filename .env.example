# 이 파일을 복사해 .env 로 만들어 쓰세요. .env 는 절대 GitHub에 올리지 마세요.
# (Railway에서는 .env 파일 대신 Variables 탭에 같은 값을 입력합니다.)

# 세션 쿠키 서명 키. 아래 명령으로 만들 수 있습니다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=여기에_랜덤한_긴_문자열

# Google OAuth (https://console.cloud.google.com > API 및 서비스 > 사용자 인증 정보)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DB와 업로드 이미지가 저장될 폴더.
# 로컬은 ./data 로 두고, Railway에서는 Volume 마운트 경로(/data)를 넣습니다.
DATA_DIR=./data

# 배포 주소. Railway는 RAILWAY_PUBLIC_DOMAIN을 자동으로 넣어주므로 보통 비워둡니다.
# PUBLIC_URL=https://내앱이름.up.railway.app

# AI 매칭 백엔드: local(기본) 또는 transformers
# EMBEDDING_BACKEND=local
