// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Source of truth for this schema: the legacy Streamlit project's
// db/schema.sql + db/database.py (SQLite). Table/column names, defaults,
// nullability, unique constraints, and cascade behavior are carried over
// as-is unless a comment below explains why PostgreSQL/Prisma required a
// different representation. No business meaning was changed intentionally.
//
// Phase 3: switched from MySQL/MariaDB (an earlier phase's placeholder
// datasource, never actually connected to a live DB) to PostgreSQL, the
// project's actual target (Supabase). See src/lib/db/prisma.ts for the
// driver adapter side of this change, and docs/VERCEL_MIGRATION_ANALYSIS.md
// / the Phase 3 report for the full MySQL-dependency audit.
//
// Connection URLs live in prisma7.config.ts, not here: Prisma 7 removed
// `url`/`directUrl` from the schema file entirely (`prisma validate` raises
// P1012 if they're present) -- see that file's `datasource` block for
// DATABASE_URL (used by Migrate) and src/lib/db/prisma.ts for the separate
// PrismaPg adapter the actual application runtime uses (also DATABASE_URL,
// but read directly from process.env, independent of this schema).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
// Korean status/category values from the original CHECK constraints are
// kept as the actual stored value via @map, while the enum member name
// itself stays a plain identifier (Prisma enum members can't contain
// spaces).

enum LostPostStatus {
  SEARCHING @map("찾는 중")
  FOUND     @map("찾음")
}

enum FoundPostStatus {
  KEEPING   @map("보관 중")
  COMPLETED @map("완료")
}

// Shared by Report.targetType and ModerationAction.targetType -- both
// CHECK constraints in schema.sql list the identical three values, so one
// enum is reused rather than declaring two identical ones.
enum ReportTargetType {
  POST    @map("post")
  MESSAGE @map("message")
  USER    @map("user")
  // Phase C-3: Comment.id is its own single AUTOINCREMENT sequence (unlike
  // LostPost/FoundPost, which independently restart at 1 and need the
  // sign-encoding trick in report/targets.ts) -- so, like MESSAGE/USER
  // above, no encoding is needed for a comment target_id either.
  COMMENT @map("comment")
}

enum ReportStatus {
  PENDING   @map("pending")
  DISMISSED @map("dismissed")
  ACTIONED  @map("actioned")
}

enum ModerationActionType {
  DELETE_POST    @map("delete_post")
  HIDE_MESSAGE   @map("hide_message")
  SUSPEND_USER   @map("suspend_user")
  // Phase C-3: the one action a COMMENT-targeted report can apply -- see
  // moderation/service.ts's applyReportAction().
  DELETE_COMMENT @map("delete_comment")
}

enum NotificationType {
  MESSAGE          @map("message")
  MATCH            @map("match")
  REPORT_PROCESSED @map("report_processed")
  POST_DELETED     @map("post_deleted")
  MESSAGE_HIDDEN   @map("message_hidden")
  USER_SUSPENDED   @map("user_suspended")
  COMMENT_REPLY    @map("comment_reply")
}

// ---------- User ----------

model User {
  id              Int       @id @default(autoincrement())
  // Phase H-7: opaque, unguessable identifier for public profile URLs
  // (/profile/[publicId]) -- kept entirely separate from `id` above,
  // which stays the internal identifier for ownership/relations/session
  // everywhere else in this app (see this phase's own "구현 원칙"): `id`'s
  // sequential integer nature is never itself exposed as a public handle.
  // DB-generated (`dbgenerated`, not Prisma-client-side `@default(uuid())`)
  // specifically so the migration's ALTER TABLE backfills every existing
  // user with its own distinct random value in the same statement that
  // adds the column -- Postgres evaluates a volatile DEFAULT per row for
  // pre-existing data, unlike a client-side default which only ever
  // applies to rows inserted after the change. Immutable in practice
  // because no API/action in this app ever writes to it post-creation.
  publicId        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("public_id")
  email           String    @unique
  name            String
  // Phase H-7: duplicate nicknames are now allowed by design (this
  // phase's own spec) -- public identity/URLs use `publicId` above
  // instead, so nickname no longer needs to be unique for that purpose.
  // The old idx_user_nickname/User_nickname_key UNIQUE index is dropped
  // in this phase's migration.
  nickname        String?
  isAdmin         Boolean   @default(false) @map("is_admin")
  isSuspended     Boolean   @default(false) @map("is_suspended")
  suspendedUntil  DateTime? @map("suspended_until")
  // Phase H-3: which admin most recently suspended this user -- mirrors
  // isSuspended/suspendedUntil's own "current state only, not a history
  // log" shape (see H-2's analysis): cleared to null on unsuspend, the
  // same way suspendedUntil already is. Populated by both suspend paths
  // (direct admin/users toggle AND the report-flow's suspend_user action)
  // so /admin/users always shows *some* actor for a currently-suspended
  // user regardless of which path did it -- the report-flow's own
  // ModerationAction/Report audit trail (adminUserId/processedByUserId) is
  // completely untouched by this, this is purely an additional stamp on
  // the same User row that flow was already updating. Never populated
  // retroactively for suspensions that predate this column -- those stay
  // null, permanently unknown (no source of truth exists to recover it).
  suspendedByUserId Int?  @map("suspended_by_user_id")
  suspendedBy       User? @relation("UserSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: Restrict)
  // Google's stable per-account identifier ("sub"), separate from email
  // (which Google account holders can in principle change) -- set on
  // first sign-in. There's only one provider (Google) and no next-auth
  // Adapter in use (see src/lib/auth/*), so a single nullable column here
  // is enough; a full Account table only earns its keep once a second
  // login provider needs linking to the same User.
  googleId        String?   @unique @map("google_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lostPosts             LostPost[]
  foundPosts            FoundPost[]
  comments              Comment[]
  initiatedChatRooms    ChatRoom[]         @relation("ChatRoomInitiator")
  sentMessages          Message[]          @relation("MessageSender")
  hiddenMessages        Message[]          @relation("MessageHiddenBy")
  reportsFiled          Report[]           @relation("ReportReporter")
  reportsProcessed      Report[]           @relation("ReportProcessedBy")
  moderationActions     ModerationAction[]
  notifications         Notification[]
  messageReactions      MessageReaction[]
  // Phase H-3: the reverse side of suspendedBy above -- every user this
  // admin has directly or via report-flow suspended (current state only,
  // see that field's own comment). Never queried from the User side in
  // this app today; kept only because Prisma requires the back-relation to
  // be declared on both models for a self-relation.
  suspendedByActions    User[]             @relation("UserSuspendedBy")
  appSettingsUpdates    AppSettings[]

  @@map("User")
}

// ---------- LostPost ----------

model LostPost {
  id          Int             @id @default(autoincrement())
  userId      Int             @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  title       String          @db.Text
  description String          @db.Text
  // Kept as free text (matches the original TEXT column, no CHECK/enum on
  // category in schema.sql) even though /lost and /search will likely want
  // to filter by category later -- adding an index/enum is a decision for
  // whichever phase builds that filter, not this one.
  category    String          @db.Text
  location    String          @db.Text
  // Phase 31: a fixed set of two real MJU campuses (see CAMPUSES in
  // src/lib/posts/schema.ts) -- unlike `category`/`location` above, this
  // is a brand-new field with no legacy free-text data to stay
  // compatible with, so the API validates it as a real zod enum. Still a
  // plain String column (not a DB enum) for the same "no CHECK/enum at
  // the DB level" convention `category` already follows -- see that
  // field's own comment. Required, defaulting existing/omitted rows to
  // "인문캠퍼스" per this phase's spec.
  campus      String          @default("인문캠퍼스") @db.Text
  lostAt      DateTime        @map("lost_at")
  status      LostPostStatus  @default(SEARCHING)
  imageUrl    String?         @db.Text @map("image_url")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  // pgvector, 768-dim (jhgan/ko-sroberta-multitask's output size -- see
  // docs/AI_MATCHING_ARCHITECTURE.md). Prisma has no native vector type,
  // so this is Unsupported -- it never appears in Prisma Client's
  // select/include/create/update, and is only ever touched via
  // $queryRaw/$executeRaw (src/lib/ai/vectorSearch.ts). Nullable: a post
  // with no embedding yet (creation failed to embed, or predates this
  // column) simply doesn't participate in similarity search, rather than
  // being disallowed from existing at all.
  embedding   Unsupported("vector(768)")?
  // pgvector, 768-dim (Xenova/siglip-base-patch16-224's vision-tower output
  // size -- see docs/IMAGE_EMBEDDING_POC.md). A deliberately separate
  // column from `embedding` above, never the same vector space -- text and
  // image embeddings come from different models and are never compared to
  // each other. Same Unsupported/nullable/$queryRaw-only treatment as
  // `embedding`: no image yet, or image-embedding generation failed,
  // simply means this post doesn't participate in image similarity search.
  imageEmbedding Unsupported("vector(768)")?
  // Phase 23: plain view counter, incremented via PostView's dedup ledger
  // (src/lib/posts/views.ts) rather than on every render -- see that
  // file's own comment for why. Existing rows default to 0 via the
  // migration, same as any other additive column in this schema.
  viewCount   Int             @default(0) @map("view_count")

  matches          Match[]
  comments         Comment[]
  directChatRooms  ChatRoom[] @relation("ChatRoomDirectLostPost")

  @@index([userId], map: "idx_lostpost_user_id")
  @@map("LostPost")
}

// ---------- FoundPost ----------

model FoundPost {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  title       String           @db.Text
  description String           @db.Text
  category    String           @db.Text
  location    String           @db.Text
  // See LostPost.campus's comment -- identical shape/reasoning.
  campus      String           @default("인문캠퍼스") @db.Text
  foundAt     DateTime         @map("found_at")
  status      FoundPostStatus  @default(KEEPING)
  imageUrl    String?          @db.Text @map("image_url")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  // See LostPost.embedding's comment -- identical shape/reasoning.
  embedding   Unsupported("vector(768)")?
  // See LostPost.imageEmbedding's comment -- identical shape/reasoning.
  imageEmbedding Unsupported("vector(768)")?
  // See LostPost.viewCount's comment -- identical shape/reasoning.
  viewCount   Int              @default(0) @map("view_count")

  matches          Match[]
  comments         Comment[]
  directChatRooms  ChatRoom[] @relation("ChatRoomDirectFoundPost")

  @@index([userId], map: "idx_foundpost_user_id")
  @@map("FoundPost")
}

// ---------- Match ----------

model Match {
  id           Int       @id @default(autoincrement())
  lostPostId   Int       @map("lost_post_id")
  lostPost     LostPost  @relation(fields: [lostPostId], references: [id], onDelete: Cascade)
  foundPostId  Int       @map("found_post_id")
  foundPost    FoundPost @relation(fields: [foundPostId], references: [id], onDelete: Cascade)
  score        Float
  createdAt    DateTime  @default(now()) @map("created_at")

  chatRoom ChatRoom?

  @@unique([lostPostId, foundPostId])
  @@index([lostPostId], map: "idx_match_lost_post_id")
  @@index([foundPostId], map: "idx_match_found_post_id")
  @@map("Match")
}

// ---------- MatchCandidateCache (Phase 23) ----------

// Match itself means "user-confirmed pairing" (see the comment on
// listMyMatchesSummary() in src/lib/match/service.ts -- a Match row's
// mere existence already means confirmed, there is no pending state) --
// so raw AI-ranked candidates (never confirmed, never owned by anyone)
// must not be stored there. This is a separate, disposable cache: one row
// per source post, holding whatever findMatchCandidates() last computed,
// so a second "매칭 후보 찾기" click can reuse it instead of re-running
// real ONNX inference + a pgvector scan every time. sourceType is a plain
// string (not an FK-backed enum) for the same reason Report.targetType/
// Notification.relatedType are -- see those models' own comments; there is
// no PostType enum at the DB level, only the app-level "lost"|"found"
// union. Invalidated (deleted) by src/lib/posts/aiService.ts whenever the
// source post's own embedding is recomputed, since a changed embedding can
// change what its candidates should be; a *new* post appearing on the
// opposite board does not invalidate an existing cache row -- accepted as
// a known staleness trade-off (see this phase's report) rather than
// building a full invalidation system for a "recommend, not authoritative"
// feature.
model MatchCandidateCache {
  id           Int      @id @default(autoincrement())
  sourceType   String   @map("source_type")
  sourcePostId Int      @map("source_post_id")
  candidates   Json
  computedAt   DateTime @default(now()) @map("computed_at")

  @@unique([sourceType, sourcePostId])
  @@map("MatchCandidateCache")
}

// ---------- ChatRoom ----------

// A ChatRoom is either Match-based (matchId set -- the AI-match -> confirm
// -> chat flow) OR "direct" (matchId NULL, the two directXxxPostId /
// initiatorUserId columns set instead -- a viewer messaging a post's
// author straight from the board, no Match required). Exactly one of the
// two shapes applies per row, enforced by application code, not a DB
// constraint -- same convention the legacy schema uses everywhere else
// (e.g. LostPost.category isn't constrained either).
//
// Multiple-cascade-path check: LostPost/FoundPost can each reach ChatRoom
// by two different routes -- directly via directLostPostId/
// directFoundPostId, and indirectly via Match.lostPostId/foundPostId ->
// ChatRoom.matchId. This is a converging ("diamond") cascade, not a cycle
// back to LostPost/FoundPost itself: a delete only ever travels outward
// (LostPost/FoundPost -> Match/ChatRoom -> Message), never back to its own
// origin table. PostgreSQL has no InnoDB-style restriction against this
// shape (unlike MySQL, which was the concern this comment originally
// tracked) -- multiple independent FK paths converging on the same target
// row are fine as long as they don't form an actual cycle, which this
// doesn't. Per row only one of the two routes is ever populated, so in
// practice a given ChatRoom is only ever deleted by one of them. Verified
// via `prisma migrate diff --from-empty --to-schema-datamodel` (generates
// the CREATE TABLE/FK SQL without needing a live DB) in Phase 3 -- see the
// Phase 3 report. If `prisma db push`/`migrate dev` against a real
// Supabase instance ever rejects this shape anyway, the fallback is to
// drop CASCADE on the two direct_* FKs and delete those rooms explicitly
// in application code instead.
model ChatRoom {
  id                   Int        @id @default(autoincrement())
  matchId              Int?       @unique @map("match_id")
  match                Match?     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  directLostPostId     Int?       @map("direct_lost_post_id")
  directLostPost       LostPost?  @relation("ChatRoomDirectLostPost", fields: [directLostPostId], references: [id], onDelete: Cascade)
  directFoundPostId    Int?       @map("direct_found_post_id")
  directFoundPost      FoundPost? @relation("ChatRoomDirectFoundPost", fields: [directFoundPostId], references: [id], onDelete: Cascade)
  initiatorUserId      Int?       @map("initiator_user_id")
  initiator            User?      @relation("ChatRoomInitiator", fields: [initiatorUserId], references: [id], onDelete: Restrict)
  createdAt            DateTime   @default(now()) @map("created_at")

  messages Message[]

  // The legacy SQLite indexes use `WHERE direct_lost_post_id IS NOT NULL`
  // partial indexes. Unlike MySQL (which can't express those at all),
  // PostgreSQL supports real partial unique indexes -- but Phase 3 checked
  // and this plain composite unique constraint already reproduces the exact
  // same behavior on any standard-SQL database (Postgres included) via NULL
  // semantics: a row is only compared for uniqueness when *every* column in
  // the constraint is non-null, so a row with a NULL directLostPostId/
  // directFoundPostId -- i.e. every Match-based room, and initiatorUserId
  // is NULL there too -- never collides with anything. No raw-SQL migration
  // needed for this; only reach for one if a future change makes this
  // column pair non-null outside the "direct room" case.
  @@unique([directLostPostId, initiatorUserId], map: "idx_chatroom_direct_lost_unique")
  @@unique([directFoundPostId, initiatorUserId], map: "idx_chatroom_direct_found_unique")
  @@map("ChatRoom")
}

// ---------- Message ----------

model Message {
  id               Int       @id @default(autoincrement())
  chatRoomId       Int       @map("chat_room_id")
  chatRoom         ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderUserId     Int       @map("sender_user_id")
  sender           User      @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  content          String    @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  readAt           DateTime? @map("read_at")
  hiddenAt         DateTime? @map("hidden_at")
  hiddenByUserId   Int?      @map("hidden_by_user_id")
  hiddenBy         User?     @relation("MessageHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: Restrict)
  hiddenReason     String?   @db.Text @map("hidden_reason")
  // Phase 28-3: same "public Storage URL string, nullable" shape as
  // LostPost/FoundPost.imageUrl -- a message can carry an image instead
  // of (or alongside) text; `content` stays a required column (an
  // image-only message stores "" there, see chat/service.ts::sendMessage),
  // so this is a purely additive column with zero migration needed for
  // any existing row (defaults to NULL, meaning "no image", for every
  // message sent before this phase).
  imageUrl         String?   @db.Text @map("image_url")
  // Phase D-3: unlike Comment.parentId (Cascade, capped at one level),
  // replies here have no depth limit -- replying to a reply is normal
  // chat UX (KakaoTalk/Instagram DMs both allow it) -- and use
  // onDelete: SetNull rather than Cascade: there is no message-delete
  // feature in this app (only hide, via Report/ModerationAction), so this
  // never fires today, but SetNull is the semantically safe choice if one
  // is ever added -- losing the "replied to" pointer on an old message
  // should never cascade-delete an entire reply chain's worth of chat
  // history.
  replyToMessageId Int?      @map("reply_to_message_id")
  replyToMessage   Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReplies")
  // Phase D-4
  reactions        MessageReaction[]

  @@index([chatRoomId], map: "idx_message_chat_room_id")
  // Mirrors idx_message_chat_room_created_id, which backs the
  // cursor-paginated message list query directly from the index.
  @@index([chatRoomId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_message_chat_room_created_id")
  @@index([replyToMessageId], map: "idx_message_reply_to")
  @@map("Message")
}

// ---------- MessageReaction (Phase D-4) ----------

// One row per (message, user, emoji) -- a user can react to the same
// message with several different emoji at once (each its own row), but
// never the same emoji twice (the @@unique below is the toggle's actual
// enforcement: "add" is an insert, "remove" is a delete keyed on this
// same triple, so a double-click race can't ever produce two rows for
// the same reaction). message: Cascade (supplementary data tied to the
// message's own lifecycle, same as Comment.parentId's reasoning) -- user:
// Restrict, matching every other User relation in this schema (Message.
// sender, Comment.author, Report.reporter, ...): there is no user-delete
// feature anywhere in this app, so this never actually blocks anything
// today, but it keeps this model consistent with the rest instead of
// inventing its own convention.
model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  emoji     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([messageId, userId, emoji])
  @@index([messageId], map: "idx_message_reaction_message_id")
  @@map("MessageReaction")
}

// ---------- Report ----------

model Report {
  id                 Int              @id @default(autoincrement())
  reporterUserId     Int              @map("reporter_user_id")
  reporter           User             @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  targetType         ReportTargetType @map("target_type")
  // Polymorphic reference (post/message/user, per targetType) -- not a
  // real foreign key in the legacy schema either, so it stays a plain
  // column here too.
  targetId           Int              @map("target_id")
  reason             String           @db.Text
  detail             String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  status             ReportStatus     @default(PENDING)
  processedAt        DateTime?        @map("processed_at")
  processedByUserId  Int?             @map("processed_by_user_id")
  processedBy        User?            @relation("ReportProcessedBy", fields: [processedByUserId], references: [id], onDelete: Restrict)
  adminNote          String?          @db.Text @map("admin_note")

  moderationAction ModerationAction?

  @@unique([reporterUserId, targetType, targetId])
  @@index([reporterUserId], map: "idx_report_reporter_user_id")
  @@index([status], map: "idx_report_status")
  @@map("Report")
}

// ---------- ModerationAction ----------

model ModerationAction {
  id           Int                  @id @default(autoincrement())
  reportId     Int                  @unique @map("report_id")
  report       Report               @relation(fields: [reportId], references: [id], onDelete: Restrict)
  targetType   ReportTargetType     @map("target_type")
  targetId     Int                  @map("target_id")
  actionType   ModerationActionType @map("action_type")
  reason       String?              @db.Text
  adminUserId  Int                  @map("admin_user_id")
  adminUser    User                 @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now()) @map("created_at")
  expiresAt    DateTime?            @map("expires_at")

  @@map("ModerationAction")
}

// ---------- Notification ----------

model Notification {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  type         NotificationType
  title        String           @db.Text
  content      String           @db.Text
  // @db.Text is safe here even though this column is part of the composite
  // unique index below: PostgreSQL (unlike MySQL, which needs a prefix
  // length for TEXT/BLOB columns in an index) has no such restriction, and
  // Prisma's default `String` native type under the postgresql provider is
  // already `text` regardless -- this annotation is just made explicit for
  // consistency with the rest of this schema. Same free-text, no-FK shape
  // as Report/ModerationAction's targetId in the legacy schema.
  relatedType  String?          @db.Text @map("related_type")
  relatedId    Int?             @map("related_id")
  isRead       Boolean          @default(false) @map("is_read")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([userId, type, relatedType, relatedId])
  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notification_user_read_created")
  @@map("Notification")
}

// ---------- Comment (Phase 23) ----------

// Same "exactly one of two nullable direct-post FKs" shape as ChatRoom's
// directLostPostId/directFoundPostId (see that model's own long comment)
// -- chosen over a polymorphic (postType, postId) pair with no real FK
// (the way Report.targetId/Notification.relatedId work) specifically so
// deleting a LostPost/FoundPost real-FK-cascades its comments at the DB
// level, with no orphan rows possible and no application code needed to
// clean them up. Enforced as "exactly one set" by application code only
// (comment/service.ts), not a DB constraint -- same convention this
// schema already uses everywhere a row can point at one of two tables.
model Comment {
  id             Int        @id @default(autoincrement())
  lostPostId     Int?       @map("lost_post_id")
  lostPost       LostPost?  @relation(fields: [lostPostId], references: [id], onDelete: Cascade)
  foundPostId    Int?       @map("found_post_id")
  foundPost      FoundPost? @relation(fields: [foundPostId], references: [id], onDelete: Cascade)
  authorUserId   Int        @map("author_user_id")
  author         User       @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  content        String     @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  // Phase C-2: one level of replies only, enforced in application code
  // (comment/service.ts rejects creating a reply whose parent already has
  // a parentId of its own) -- not a DB constraint, same convention as the
  // "exactly one of lostPostId/foundPostId" rule above. onDelete: Cascade
  // means deleting a top-level comment also deletes its own replies,
  // never anything deeper (depth is capped at 1 by construction).
  parentId       Int?       @map("parent_id")
  parent         Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]  @relation("CommentReplies")

  @@index([lostPostId, createdAt], map: "idx_comment_lost_post_created")
  @@index([foundPostId, createdAt], map: "idx_comment_found_post_created")
  @@index([parentId], map: "idx_comment_parent")
  @@map("Comment")
}

// ---------- PostView (Phase 23) ----------

// A dedup ledger, not a page-view analytics table: one row per (post,
// viewer), overwritten (not appended) on every subsequent view -- see
// src/lib/posts/views.ts for the actual "skip increment if viewedAt is
// recent" window logic. viewerKey is "u:<User.id>" for a signed-in viewer
// or "a:<anonymous cookie id>" for a logged-out one (this app's read
// paths are intentionally public/no-auth-required -- see posts/service.ts
// -- so view counting must work without a User row to key on). No FK to
// LostPost/FoundPost (same polymorphic postType/postId convention as
// Report.targetId) -- a row surviving after its post is deleted is inert
// bookkeeping, never read back for anything once the post is gone.
model PostView {
  id         Int      @id @default(autoincrement())
  postType   String   @map("post_type")
  postId     Int      @map("post_id")
  viewerKey  String   @map("viewer_key")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  @@unique([postType, postId, viewerKey])
  @@map("PostView")
}

// ---------- AppSettings (Phase H-3) ----------

// A single-row (id=1) global settings table -- this app's first, so kept
// as a plain singleton rather than a generic key/value table: one real
// setting exists today (googleTestModeEnabled), and a second one can add
// its own column here later the same way LostPost.campus was added to an
// existing table, without inventing a schema-less config store this
// project has never needed anywhere else.
model AppSettings {
  id                    Int      @id @default(1)
  // Phase H-3: server-side gate the NextAuth signIn callback consults for
  // any Google account outside @mju.ac.kr (see src/lib/auth/domain.ts) --
  // OFF by default, so a fresh/未configured row (or no row at all, see
  // getAppSettings()) always means "mju.ac.kr only", never accidentally
  // open. Toggled only via PATCH /api/admin/settings, which re-verifies
  // admin status server-side regardless of what the UI shows.
  googleTestModeEnabled Boolean  @default(false) @map("google_test_mode_enabled")
  updatedAt             DateTime @updatedAt @map("updated_at")
  updatedByUserId       Int?     @map("updated_by_user_id")
  updatedBy             User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("AppSettings")
}
